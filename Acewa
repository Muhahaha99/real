CrosshairDot.Filled = true
CrosshairDot.Color = Color3.fromRGB(255, 0, 0)
CrosshairDot.Visible = Settings.ShowCrosshairDot

-- คำนวณตำแหน่งเป้าหมาย 3D + ความสูง Offset
local function getPredictedPosition(targetPart)
	local currentPos = targetPart.Position
	local velocity = targetPart.AssemblyLinearVelocity
	
	if Settings.PredictionEnabled and velocity then
		currentPos = currentPos + (velocity * Settings.PredictionFactor)
	end
	
	-- ⭐ บวกความสูงที่ปรับได้ (Offset Y)
	return currentPos + Vector3.new(0, Settings.AimOffsetY, 0)
end

local function getClosestPlayer()
	local closestPlayer = nil
	local shortestDistance = Settings.FOVRadius
	local viewportSize = Camera.ViewportSize
	local centerPos = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character and p.Character:FindFirstChild("Humanoid") then
			local humanoid = p.Character.Humanoid
			local targetPart = p.Character:FindFirstChild(Settings.TargetPart)

			if humanoid.Health > 0 and targetPart then
				if Settings.TeamCheck and p.Team == player.Team then continue end

				local target3DPos = getPredictedPosition(targetPart)
				local screenPos, onScreen = Camera:WorldToViewportPoint(target3DPos)

				if onScreen then
					local targetScreenPos = Vector2.new(screenPos.X, screenPos.Y)
					local distance = (targetScreenPos - centerPos).Magnitude

					if distance < shortestDistance then
						if Settings.WallCheck then
							-- ⭐ ใช้ RaycastParams แบบใหม่ที่แม่นยำกว่า FindPartOnRay มาก
							local rayParams = RaycastParams.new()
							rayParams.FilterType = Enum.RaycastFilterType.Exclude
							rayParams.FilterDescendantsInstances = {player.Character, Camera}
							rayParams.IgnoreWater = false
							rayParams.RespectCanCollide = false
							
							local rayOrigin = Camera.CFrame.Position
							local rayDir = target3DPos - rayOrigin
							local result = Workspace:Raycast(rayOrigin, rayDir, rayParams)
							
							if not result or result.Instance:IsDescendantOf(p.Character) then
								shortestDistance = distance
								closestPlayer = p
							end
						else
							shortestDistance = distance
							closestPlayer = p
						end
					end
				end
			end
		end
	end
	return closestPlayer
end

-- แสดงวงกลม FOV และจุดเป้าแดง (อัปเดตความสูงตาม AimOffsetY)
RunService.RenderStepped:Connect(function()
	local viewportSize = Camera.ViewportSize
	local centerScreen = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)

	FOVCircle.Position = centerScreen
	FOVCircle.Radius = Settings.FOVRadius
	FOVCircle.Visible = Settings.ShowFOV and Settings.AimbotEnabled
	FOVCircle.Color = Settings.FOVColor

	-- ⭐ อัปเดตจุดเป้าแดงให้ลอยขึ้น/ลงตาม AimOffsetY และระยะห่างจากกล้อง
	if Settings.ShowCrosshairDot and Settings.AimbotEnabled then
		-- คำนวณจุด 3D ล่วงหน้าจากกล้อง (10 studs ไปข้างหน้า) แล้วบวกค่าความสูง
		local lookVector = Camera.CFrame.LookVector
		local point3D = Camera.CFrame.Position + (lookVector * 10) + Vector3.new(0, Settings.AimOffsetY, 0)
		local screenPos, onScreen = Camera:WorldToViewportPoint(point3D)
		
		if onScreen then
			CrosshairDot.Position = Vector2.new(screenPos.X, screenPos.Y)
			CrosshairDot.Visible = true
		else
			CrosshairDot.Visible = false
		end
	else
		CrosshairDot.Visible = false
	end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == aimbotToggleKey then
		Settings.AimbotEnabled = not Settings.AimbotEnabled
	end
end)

-- ทำงานหันกล้องล็อกเป้าหมาย
RunService.RenderStepped:Connect(function()
	if Settings.AimbotEnabled then
		local targetPlayer = getClosestPlayer()
		if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild(Settings.TargetPart) then
			local targetPart = targetPlayer.Character[Settings.TargetPart]
			local targetPos = getPredictedPosition(targetPart) -- ใช้ตำแหน่งที่บวก Offset แล้ว
			local cameraPos = Camera.CFrame.Position
			
			local targetCFrame = CFrame.new(cameraPos, targetPos)
			Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, Settings.Smoothness)
		end
	end
end)

